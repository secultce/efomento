@startuml
!theme lightgray
skinparam classAttributeIconSize 0
skinparam class {
    BackgroundColor #E8F5E9
    BorderColor #2E7D32
    ArrowColor #01579B
}

class File {
    -id: bigint
    -mime_type: string
    -name: string
    -object_type: string
    -object_id: bigint
    -grp: string(32)
    -description: text
    -path: string(1024)
    -private: boolean
    -created_at: timestamp
    -updated_at: timestamp
    -deleted_at: timestamp
    --
    +fileable(): MorphTo
    +getUrlAttribute(): ?string
    +scopePublic(query): Builder
    +scopeByGroup(query, grp: string): Builder
}

note top of File
  <b>Trait:</b> SoftDeletes
  <b>Indices:</b> (object_type, object_id), grp
end note

note bottom of File
  <b>object_type / object_id:</b> polimorfismo via morph map
  <b>grp:</b> agrupador (ex: contrato, relatorio)
  <b>private:</b> se true, url sempre retorna null
  <b>path:</b> gerado no upload
  padrao: alias/id/slug.ext
  <b>url:</b> retorna null se private=true ou path vazio
end note
@enduml
